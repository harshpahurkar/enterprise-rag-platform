# ╔══════════════════════════════════════════════════════════════╗
# ║  Enterprise RAG Platform environment                         ║
# ║  Copy this file to .env and fill in the values:              ║
# ║      cp .env.example .env                                    ║
# ║  Never commit .env. Docker Compose and the backend read it.  ║
# ╚══════════════════════════════════════════════════════════════╝
# Comments sit above each variable, not inline: Spring reads this file as
# a .properties file, where a trailing "# ..." would become part of the value.

# ── Database ──
# Postgres user. Any name; the db container is created with it.
POSTGRES_USER=rag
# Postgres password. Any string; change it for anything beyond local dev.
POSTGRES_PASSWORD=change-me

# ── Auth ──
# Required. HMAC signing key, at least 32 bytes. Generate one: openssl rand -base64 48
JWT_SECRET=replace-with-generated-secret

# ── LLM ──
# Optional. Search works without it; Ask needs it. Paste your key (starts with sk-ant-) after the =
ANTHROPIC_API_KEY=
# Optional. Any Anthropic model id. Default: claude-opus-5-5
LLM_MODEL=claude-opus-5-5

# ── Demo ──
# Optional. Password for the seeded demo users (demo profile only). Default: demo-password
DEMO_PASSWORD=demo-password
